{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "cortex.runtime-policy.v1"
    },
    "format_version": {
      "type": "integer",
      "const": 1
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "podman-linux-rootless.v1": {
          "$ref": "#/$defs/linux_profile"
        },
        "podman-macos-machine-rootless.v1": {
          "$ref": "#/$defs/macos_profile"
        }
      },
      "required": [],
      "minProperties": 1,
      "maxProperties": 2
    }
  },
  "required": [
    "schema",
    "format_version",
    "profiles"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kaidera:cortex:runtime-policy:v1",
  "$comment": "DESIGN PROPOSAL ONLY, H-D538. Shape validation cannot verify signatures, actual backend capability, minimum baseline, cross-field date ordering, duplicate raw JSON keys, UTF-8 byte bounds, or semantic policy union. The existing semantic predicates and actual receipts are required. No engine/profile is admitted by validating this JSON.",
  "$defs": {
    "denied_entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "version",
        "date",
        "reason"
      ]
    },
    "denylist": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "entries": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/denied_entry"
          }
        }
      },
      "required": [
        "as_of",
        "entries"
      ]
    },
    "podman_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "podman"
        },
        "host_os": {
          "enum": [
            "linux",
            "macos"
          ]
        },
        "backend": {
          "enum": [
            "native-rootless",
            "podman-machine-rootless"
          ]
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "linux/amd64",
              "linux/arm64"
            ]
          }
        },
        "provider": {
          "const": "cortex-native-lifecycle"
        },
        "minimum_version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "denylist": {
          "$ref": "#/$defs/denylist"
        },
        "required_capabilities": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "oci_digest_identity",
              "nonroot_engine_owner",
              "local_engine_endpoint",
              "owned_store_binding",
              "loopback_publication",
              "scoped_resource_ownership",
              "health_effect_readback",
              "retained_data_lifecycle"
            ]
          }
        }
      },
      "required": [
        "engine",
        "host_os",
        "backend",
        "platforms",
        "provider",
        "minimum_version",
        "denylist",
        "required_capabilities"
      ]
    },
    "linux_profile": {
      "allOf": [
        {
          "$ref": "#/$defs/podman_profile"
        },
        {
          "properties": {
            "host_os": {
              "const": "linux"
            },
            "backend": {
              "const": "native-rootless"
            }
          }
        }
      ]
    },
    "macos_profile": {
      "allOf": [
        {
          "$ref": "#/$defs/podman_profile"
        },
        {
          "properties": {
            "host_os": {
              "const": "macos"
            },
            "backend": {
              "const": "podman-machine-rootless"
            },
            "platforms": {
              "const": [
                "linux/arm64"
              ]
            }
          }
        }
      ]
    }
  }
}
