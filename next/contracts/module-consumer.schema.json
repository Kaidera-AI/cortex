{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaidera.local/contracts/module-consumer/v1",
  "title": "C07 module manifest and durable target receipt",
  "oneOf": [
    {
      "type": "object",
      "required": ["module_id", "protocol_version", "schema_version", "aggregate_kinds", "sink"],
      "additionalProperties": false,
      "properties": {
        "module_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "protocol_version": {"const": 1},
        "schema_version": {"const": 1},
        "aggregate_kinds": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "sink": {"const": "postgres"}
      }
    },
    {
      "type": "object",
      "required": ["event_id", "aggregate_id", "revision", "tombstone", "payload_sha256", "generation", "stale"],
      "additionalProperties": false,
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "aggregate_id": {"type": "string", "format": "uuid"},
        "revision": {"type": "integer", "minimum": 1},
        "tombstone": {"type": "boolean"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generation": {"type": "integer", "minimum": 1},
        "stale": {"type": "boolean"}
      }
    }
  ]
}
