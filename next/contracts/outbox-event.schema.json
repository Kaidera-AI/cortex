{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kaidera:cortex:outbox:event:1",
  "title": "Cortex outbox immutable event envelope v1",
  "type": "object",
  "required": [
    "event_id",
    "installation_id",
    "tenant_id",
    "project_id",
    "aggregate_id",
    "payload_ref",
    "aggregate_kind",
    "aggregate_revision",
    "schema_version",
    "operation",
    "tombstone",
    "payload_sha256",
    "occurred_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "installation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "project_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "payload_ref": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "aggregate_kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}(?![\\s\\S])"
    },
    "aggregate_revision": {
      "type": "integer",
      "minimum": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "operation": {
      "enum": [
        "upsert",
        "delete"
      ]
    },
    "tombstone": {
      "type": "boolean"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "minLength": 64,
      "maxLength": 64
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "delete"
          }
        }
      },
      "then": {
        "properties": {
          "tombstone": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "tombstone": {
            "const": false
          }
        }
      }
    }
  ],
  "description": "I0 seam. Immutable event identity and tenant/project scope; aggregate_revision is aggregate-local, not a feed cursor. payload_ref names durable immutable payload bytes whose SHA256 must match. Feed publication cursor is a separate committed delivery envelope; no allocated ID or MAX is a commit watermark."
}
