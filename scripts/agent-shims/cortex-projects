#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$#" -ne 0 ] || [ -z "${CORTEX_CONNECTION_PROFILE:-}" ]; then
    printf '%s\n' 'ERROR: cortex-projects requires CORTEX_CONNECTION_PROFILE and no arguments' >&2
    exit 2
fi
exec "${SCRIPT_DIR}/cortex-agent" --config "${CORTEX_CONNECTION_PROFILE}" projects
