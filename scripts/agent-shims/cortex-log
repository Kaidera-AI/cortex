#!/usr/bin/env bash
# Release-owned native log command; only the non-secret profile crosses shell.
set -euo pipefail
directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -z "${CORTEX_CONNECTION_PROFILE:-}" ]; then
    printf '%s\n' 'ERROR: select CORTEX_CONNECTION_PROFILE (non-secret v2 member profile)' >&2
    exit 2
fi
exec "${directory}/cortex-agent" --config "${CORTEX_CONNECTION_PROFILE}" log "$@"
