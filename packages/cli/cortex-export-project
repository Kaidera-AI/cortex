#!/usr/bin/env bash
# Export one Cortex project through the admin API using named JSON fields.
# Endpoint: /admin/projects/${ENCODED_PROJECT}/export
# _cortex_export.py writes the same SHA-256 sidecar as shasum -a 256, but hashes
# incrementally and validates the complete staged document before publication.
set -euo pipefail
umask 077

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec python3 -B "${SCRIPT_DIR}/_cortex_export.py" "$@"
