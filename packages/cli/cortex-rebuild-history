#!/usr/bin/env bash
# cortex-rebuild-history — safely re-ingest available local transcripts, preserving other history
# Usage: cortex-rebuild-history [--dry-run] [--claude-dir <dir>] [--codex-dir <dir>]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/_cortex_lib.sh"

DRY_RUN=false
CLAUDE_DIR_OVERRIDE=""
CODEX_DIR="${CODEX_DIR:-$HOME/.codex/sessions}"
FALLBACK_AGENT="$(cortex_normalize_agent_name "${CORTEX_AGENT:-${CORTEX_AGENT_ID:-${BEAT_CORTEX_AGENT:-}}}" 2>/dev/null || true)"

usage() {
    echo "Usage: cortex-rebuild-history [--dry-run] [--claude-dir <dir>] [--codex-dir <dir>]"
    exit 1
}

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --claude-dir)
            [ $# -ge 2 ] || usage
            CLAUDE_DIR_OVERRIDE="$2"
            shift 2
            ;;
        --codex-dir)
            [ $# -ge 2 ] || usage
            CODEX_DIR="$2"
            shift 2
            ;;
        --help|-h)
            usage
            ;;
        *)
            usage
            ;;
    esac
done

get_codex_agent() {
    local uuid="$1"
    local map_file="$2"
    local match
    match=$(grep "^${uuid}=" "$map_file" 2>/dev/null | head -1 | cut -d= -f2)
    if [ -n "${match}" ]; then
        cortex_normalize_agent_name "${match}"
        return 0
    fi
    [ -n "${FALLBACK_AGENT}" ] || return 1
    printf '%s\n' "${FALLBACK_AGENT}"
}

CLAUDE_FILES=()
while IFS= read -r claude_dir; do
    [ -d "$claude_dir" ] || continue
    while IFS= read -r session_file; do
        [ -f "$session_file" ] || continue
        CLAUDE_FILES+=("$session_file")
    done < <(find "$claude_dir" -maxdepth 1 -type f -name "*.jsonl" | sort)
done < <(discover_claude_dirs "$CLAUDE_DIR_OVERRIDE")

CODEX_FILES=()
while IFS= read -r session_file; do
    [ -f "$session_file" ] || continue
    CODEX_FILES+=("$session_file")
done < <(discover_codex_sessions "$CODEX_DIR")

echo "═══════════════════════════════════════════"
echo "  Cortex — Rebuild Project History"
echo "═══════════════════════════════════════════"
echo ""
echo "Project: ${CORTEX_PROJECT}"
echo "Project Root: ${PROJECT_ROOT}"
echo "Claude sessions discovered: ${#CLAUDE_FILES[@]}"
echo "Codex sessions discovered: ${#CODEX_FILES[@]}"
echo ""

# Read-only planning precedes every ingest. Never delete all project history:
# the ordinary ingester atomically replaces only its own project/session UUID.
PLAN_HELPER="$SCRIPT_DIR/cortex_history_plan.py"
[ -f "$PLAN_HELPER" ] || { echo "ERROR: history plan helper unavailable; no history was purged." >&2; exit 2; }
CLAUDE_LIST=$(mktemp)
CODEX_LIST=$(mktemp)
ROWS_FILE=$(mktemp)
PLAN_FILE=$(mktemp)
EXEC_FILE=$(mktemp)
CODEX_MAP_FILE=$(mktemp)
trap 'rm -f "$CLAUDE_LIST" "$CODEX_LIST" "$ROWS_FILE" "$PLAN_FILE" "$EXEC_FILE" "$CODEX_MAP_FILE"' EXIT
printf '%s\0' "${CLAUDE_FILES[@]}" > "$CLAUDE_LIST"
printf '%s\0' "${CODEX_FILES[@]}" > "$CODEX_LIST"
INPUT_IDS=$(python3 "$PLAN_HELPER" ids "$CLAUDE_LIST" "$CODEX_LIST")
PROJECT_SQL=$(sql_escape "${CORTEX_PROJECT}")
pg_query "SELECT COALESCE(json_agg(row_to_json(r)), '[]'::json) FROM (
 SELECT s.id::text AS id, s.project, s.notes->>'source' AS note_source,
        src.provider, src.source_kind, src.source_path,
        COALESCE((SELECT json_agg(DISTINCT m.metadata->>'source')
                  FROM messages m WHERE m.session_id=s.id AND m.project=s.project), '[]'::json) AS message_sources
 FROM agent_sessions s LEFT JOIN session_sources src ON src.session_id=s.id AND src.project=s.project
 WHERE s.project='${PROJECT_SQL}' OR s.id IN (${INPUT_IDS})
 ORDER BY s.id
) r;" > "$ROWS_FILE"
python3 "$PLAN_HELPER" plan "$ROWS_FILE" "$CLAUDE_LIST" "$CODEX_LIST" "$SCRIPT_DIR" "$CORTEX_PROJECT" > "$PLAN_FILE"
python3 "$PLAN_HELPER" report "$PLAN_FILE"
if [ "$DRY_RUN" = true ]; then
    echo "Dry run only. No database changes made."
    exit 0
fi
if [ -z "${FALLBACK_AGENT}" ]; then
    echo "ERROR: fallback agent required; no history was purged." >&2
    exit 2
fi
python3 "$PLAN_HELPER" execute-list "$PLAN_FILE" > "$EXEC_FILE" || {
    echo "ERROR: required parser unavailable; sessions preserved, no history was purged." >&2
    exit 2
}
build_codex_agent_map > "$CODEX_MAP_FILE" 2>/dev/null || true
while IFS='|' read -r source_uuid provider session_file; do
    [ -n "$source_uuid" ] || continue
    if [ "$provider" = claude ]; then
        "$SCRIPT_DIR/cortex-ingest-session" "$session_file" "$FALLBACK_AGENT" >/dev/null
    else
        agent_name=$(get_codex_agent "$source_uuid" "$CODEX_MAP_FILE")
        "$SCRIPT_DIR/cortex-ingest-codex" "$session_file" "$agent_name" >/dev/null
    fi
done < "$EXEC_FILE"
echo "Rebuild complete. Only reported transcript UUIDs were re-ingested; all other history was preserved."
