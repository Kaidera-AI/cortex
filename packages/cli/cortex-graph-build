#!/usr/bin/env bash
# cortex-graph-build — build graph through API by default.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<'EOF'
Usage: cortex-graph-build [--repo PATH] [--full] [--no-embed]
                          [--import-existing]
                          [--sync|--async] [--no-wait|--wait]
                          [--wait-timeout SECONDS] [--poll-interval SECONDS]
       cortex-graph-build --job JOB_ID

Build or update the managed L3 code graph for CORTEX_PROJECT through cortex-api.
PATH defaults to the current directory and must resolve to that project's exact
registered repo_root. A sibling Git worktree is a different root: register it as
a separate Cortex project before graphing it.

Generation custody:
  New and migrated projects, and projects whose repo_root changed, are held until
  the current generation completes --full or a deliberately reviewed
  --import-existing. Queries, statistics, and incremental builds fail closed
  while held. --full is the normal recovery path for a Git repository.

Build modes:
  (default)          Incrementally update an already materialized generation.
  --full             Rebuild and authorize the current repository generation.
  --import-existing  Import the exact repo-local .code-review-graph/graph.db.
                     Use only after reviewing that donor's provenance and bytes;
                     import copies the graph, does not run embedding, and cannot
                     be combined with --full.
  --no-embed         Skip the embedding phase of a full/incremental build.

Execution:
  (default/--async)  Queue a job and poll it until completion (900s default).
  --no-wait          Return the queued receipt immediately; retain its job_id.
  --job JOB_ID       Read that job's current status once; it does not wait.
  --sync             Run inline instead of creating a job (API timeout 660s).
  --wait-timeout N   Bound async polling (default: 900 or env override).
  --poll-interval N  Poll every N seconds (default: 2 or env override).

Examples:
  CORTEX_PROJECT=my-project cortex-graph-build \
    --repo /absolute/registered/root --full --wait
  CORTEX_PROJECT=my-project cortex-graph-build \
    --repo /absolute/registered/root --full --no-wait
  CORTEX_PROJECT=my-project cortex-graph-build --job <job-id>
  CORTEX_PROJECT=my-project cortex-graph-build \
    --repo /absolute/registered/root --full --sync
EOF
}

REPO="$(pwd)"
FULL=false
EMBED=true
IMPORT_EXISTING=false
ASYNC_JOB=true
SYNC=false
WAIT=true
WAIT_TIMEOUT="${CORTEX_GRAPH_BUILD_WAIT_TIMEOUT:-900}"
POLL_INTERVAL="${CORTEX_GRAPH_BUILD_POLL_INTERVAL:-2}"
JOB_ID=""
MODE="build"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --repo) REPO="$2"; shift 2 ;;
        --full) FULL=true; shift ;;
        --no-embed) EMBED=false; shift ;;
        --import-existing) IMPORT_EXISTING=true; shift ;;
        --sync) ASYNC_JOB=false; SYNC=true; WAIT=false; shift ;;
        --async) ASYNC_JOB=true; SYNC=false; shift ;;
        --no-wait) WAIT=false; shift ;;
        --wait) WAIT=true; shift ;;
        --wait-timeout) WAIT_TIMEOUT="$2"; shift 2 ;;
        --poll-interval) POLL_INTERVAL="$2"; shift 2 ;;
        --job|--status) MODE="job"; JOB_ID="$2"; shift 2 ;;
        --help|-h) usage; exit 0 ;;
        *) echo "ERROR: unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

if [ "${FULL}" = "true" ] && [ "${IMPORT_EXISTING}" = "true" ]; then
    echo "ERROR: --full and --import-existing are mutually exclusive" >&2
    exit 2
fi
if [ "${IMPORT_EXISTING}" = "true" ]; then
    # Import is an exact donor copy, not a BCRG build/embedding operation.
    EMBED=false
fi

# Parse help and reject invalid mode combinations before loading project/API
# context. This keeps --help usable on a fresh machine and ensures local CLI
# validation cannot be masked by missing Cortex configuration.
# shellcheck source=./_cortex_api.sh
source "${SCRIPT_DIR}/_cortex_api.sh"

if [ "${MODE}" = "job" ]; then
    if [ -z "${JOB_ID}" ]; then
        echo "ERROR: --job requires a job id" >&2
        exit 2
    fi
    cortex_api_call_json GET "/graph/build/jobs/${JOB_ID%%:*}"
    exit 0
fi

payload="$(python3 - "${REPO}" "${FULL}" "${EMBED}" "${ASYNC_JOB}" "${SYNC}" "${IMPORT_EXISTING}" <<'PYEOF'
import json, sys
print(json.dumps({
    "repo": sys.argv[1],
    "full": sys.argv[2].lower() == "true",
    "embed": sys.argv[3].lower() == "true",
    "async_job": sys.argv[4].lower() == "true",
    "sync": sys.argv[5].lower() == "true",
    "import_existing": sys.argv[6].lower() == "true",
}))
PYEOF
)"

BUILD_API_MAX_TIME=30
[ "${SYNC}" != "true" ] || BUILD_API_MAX_TIME=660
response="$(CORTEX_API_MAX_TIME="${BUILD_API_MAX_TIME}" cortex_api_call_json POST "/graph/build" "${payload}")"

job_id="$(python3 - "${response}" <<'PYEOF'
import json, sys
try:
    data = json.loads(sys.argv[1])
except Exception:
    raise SystemExit(0)
print(data.get("job_id") or "")
PYEOF
)"

if [ -z "${job_id}" ] || [ "${WAIT}" != "true" ]; then
    printf '%s\n' "${response}"
    exit 0
fi

printf '%s\n' "${response}" >&2
deadline=$(( $(date +%s) + WAIT_TIMEOUT ))
last_status=""
while true; do
    status_payload="$(cortex_api_call_json GET "/graph/build/jobs/${job_id}")"
    status_line="$(python3 - "${status_payload}" <<'PYEOF'
import json, sys
data = json.loads(sys.argv[1])
print("status={status} repo={repo}".format(
    status=data.get("status"),
    repo=data.get("repo", ""),
))
PYEOF
)"
    if [ "${status_line}" != "${last_status}" ]; then
        printf '%s\n' "${status_line}" >&2
        last_status="${status_line}"
    fi
    job_status="${status_line#status=}"
    job_status="${job_status%% *}"
    case "${job_status}" in
        completed)
            printf '%s\n' "${status_payload}"
            exit 0
            ;;
        failed)
            printf '%s\n' "${status_payload}"
            exit 1
            ;;
    esac
    if [ "$(date +%s)" -ge "${deadline}" ]; then
        printf 'ERROR: graph build job %s still running after %ss; inspect with cortex-graph-build --job %s\n' "${job_id}" "${WAIT_TIMEOUT}" "${job_id}" >&2
        printf '%s\n' "${status_payload}"
        exit 124
    fi
    sleep "${POLL_INTERVAL}"
done
