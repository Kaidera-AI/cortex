#!/usr/bin/env bash
# cortex-graph-blast - Blast radius for changed files or named targets
# Usage: cortex-graph-blast <file1> [file2 ...] [--depth N] [--repo <path>] [--max-results N]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_cortex_api.sh
source "${SCRIPT_DIR}/_cortex_api.sh"

MAX_DEPTH=2
MAX_RESULTS=100
REPO_ROOT=""
FILES=()

while [ $# -gt 0 ]; do
    case "$1" in
        --depth)      MAX_DEPTH="$2"; shift 2 ;;
        --repo)       REPO_ROOT="$2"; shift 2 ;;
        --target)     FILES+=("$2"); shift 2 ;;
        --max|--max-results) MAX_RESULTS="$2"; shift 2 ;;
        --help|-h)
            printf 'Usage: cortex-graph-blast <file1> [file2 ...] [--depth N] [--repo <path>] [--max-results N]\n'
            printf '\nShows graph blast radius for changed files. --target <name> is accepted for schema/component probes.\n'
            exit 0
            ;;
        *)            FILES+=("$1"); shift ;;
    esac
done

if [ ${#FILES[@]} -eq 0 ]; then
    printf 'ERROR: at least one file path required\n' >&2
    exit 1
fi
case "${MAX_DEPTH}:${MAX_RESULTS}" in
    *[!0-9:]*|:*|*:) printf 'ERROR: depth and max-results must be integers\n' >&2; exit 2 ;;
esac
if [ "${MAX_RESULTS}" -lt 1 ]; then
    printf 'ERROR: max-results must be at least 1\n' >&2; exit 2
fi

# Auto-detect repo root
if [ -z "${REPO_ROOT}" ]; then
    REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
fi

payload="$(python3 - "${REPO_ROOT}" "${MAX_DEPTH}" "${MAX_RESULTS}" "${FILES[@]}" <<'PYEOF'
import json
import sys

print(json.dumps({
    "repo": sys.argv[1],
    "depth": int(sys.argv[2]),
    "max_results": int(sys.argv[3]),
    "files": sys.argv[4:],
}))
PYEOF
)"

CORTEX_API_MAX_TIME=140 cortex_api_call_json POST "/graph/blast" "${payload}" | python3 -c '
import json
import sys

result = json.load(sys.stdin)
if not isinstance(result, dict):
    print("ERROR: malformed code graph response", file=sys.stderr)
    raise SystemExit(2)
status = result.get("status")
if status not in {"ok", "error"}:
    print("ERROR: unsupported code graph status", file=sys.stderr)
    raise SystemExit(2)
if status == "error":
    detail = str(result.get("error") or result.get("summary") or "blast query failed")
    print("ERROR: {}".format(detail[:500]), file=sys.stderr)
    raise SystemExit(1)
totals = result.get("totals")
if not isinstance(totals, dict):
    print("ERROR: malformed blast totals", file=sys.stderr)
    raise SystemExit(2)
impacted_nodes = totals.get("impacted_nodes")
impacted_files = totals.get("impacted_files")
total_impacted = result.get("total_impacted")
if any(isinstance(value, bool) or not isinstance(value, int) or value < 0 for value in (impacted_nodes, impacted_files, total_impacted)):
    print("ERROR: malformed blast counts", file=sys.stderr)
    raise SystemExit(2)
print(
    "Blast radius: {} nodes impacted ({} files)".format(
        total_impacted,
        impacted_files,
    )
)
if result.get("truncated"):
    print("  (truncated at {} results)".format(sys.argv[1]))
paths = result.get("impacted_files") or []
if not isinstance(paths, list):
    print("ERROR: malformed impacted-files list", file=sys.stderr)
    raise SystemExit(2)
for path in paths[:int(sys.argv[1])]:
    print("  {}".format(path))
changed_nodes = totals.get("changed_nodes")
if isinstance(changed_nodes, int) and not isinstance(changed_nodes, bool) and changed_nodes:
    print("\nDirectly changed: {} nodes".format(changed_nodes))
' "${MAX_RESULTS}"
