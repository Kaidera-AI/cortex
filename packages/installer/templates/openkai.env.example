# ─────────────────────────────────────────────────────────────────────────────
# OpenKai environment template.
# Copy to .env and fill in what you use. .env is gitignored — never commit keys.
# The CLI auto-loads .env from the current directory at startup (existing
# environment variables always win over .env values).
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenKai runtime ───────────────────────────────────────────────────────────
# Default provider + model for chat/tui/fuse.
#OPENKAI_PROVIDER=openrouter
#OPENKAI_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# ── Aggregator ────────────────────────────────────────────────────────────────
# One key, 300+ models — the default lane.
#OPENROUTER_API_KEY=

# ── Direct providers (use with --provider / OPENKAI_PROVIDER) ─────────────────
#ANTHROPIC_API_KEY=            # claude models (provider: anthropic)
#OPENAI_API_KEY=               # gpt models (provider: openai)
#GEMINI_API_KEY=               # google models (provider: google)
#DEEPSEEK_API_KEY=             # provider: deepseek
#KIMI_API_KEY=                 # Kimi Code (provider: kimi-coding)
#MOONSHOT_API_KEY=             # provider: moonshotai
#QWEN_TOKEN_PLAN_API_KEY=      # Alibaba Qwen subscription (provider: qwen-token-plan)
#XAI_API_KEY=                  # provider: xai
#MISTRAL_API_KEY=              # provider: mistral
#GROQ_API_KEY=                 # provider: groq
#CEREBRAS_API_KEY=             # provider: cerebras
#TOGETHER_API_KEY=             # provider: together
#FIREWORKS_API_KEY=            # provider: fireworks
#NVIDIA_API_KEY=               # provider: nvidia
#MINIMAX_API_KEY=              # provider: minimax
#ZAI_API_KEY=                  # provider: zai
#AI_GATEWAY_API_KEY=           # Vercel AI Gateway (provider: vercel-ai-gateway)

# ── Subscription / OAuth lanes ────────────────────────────────────────────────
# These providers authenticate via OAuth flows, not raw keys:
#   openai-codex     — ChatGPT/Codex subscription (OAuth login)
#   github-copilot   — GitHub Copilot subscription (OAuth device flow)
#   anthropic        — also accepts subscription OAuth tokens:
#ANTHROPIC_OAUTH_TOKEN=
#ANTHROPIC_AUTH_TOKEN=

# ── Cortex (KOS-managed mode) ─────────────────────────────────────────────────
# Unset = standalone-local mode (local persistence only, fully offline-capable).
#CORTEX_PROJECT=openkai
#CORTEX_API_URL=http://localhost:8501
# Operator-only: admin-gated endpoints (epic registry writes). Not needed for daily use.
#CORTEX_ADMIN_TOKEN=
